# Environment Variables Template for Todo AI Chatbot
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Database Configuration (Neon PostgreSQL)
# =============================================================================
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:pass@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb
DATABASE_URL=postgresql://user:password@host:5432/dbname

# =============================================================================
# JWT Configuration
# =============================================================================
# Generate a secure secret key with: openssl rand -hex 32
SECRET_KEY=your-jwt-secret-key-here-use-openssl-rand-hex-32

# Token expiration settings
REFRESH_TOKEN_EXPIRE_DAYS=7
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
# Docker Compose: http://localhost:3000,http://frontend:3000
# Kubernetes: http://localhost:30080,http://todo-frontend:3000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# =============================================================================
# Application Environment
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# =============================================================================
# Deployment-Specific Configuration
# =============================================================================
# For Docker Compose: Use "backend" for internal service name
# For local development: Use "localhost"
BACKEND_URL=http://backend:8000

# For Next.js frontend (build-time variable)
NEXT_PUBLIC_API_URL=http://localhost:8000
