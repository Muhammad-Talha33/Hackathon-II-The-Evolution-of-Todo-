# =============================================================================
# Backend Secrets - Todo AI Chatbot
# =============================================================================
# TEMPLATE FILE - Copy to secrets.yaml and fill in base64-encoded values
#
# To encode values:
#   echo -n "your-value" | base64
#
# NEVER commit the actual secrets.yaml file!
# =============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: todo-backend-secrets
  labels:
    app: todo-backend
type: Opaque
data:
  # Base64 encoded values - replace with your actual encoded secrets
  # Example: echo -n "postgresql+asyncpg://user:pass@host/db" | base64
  DATABASE_URL: <base64-encoded-database-url>

  # Example: echo -n "your-secret-key-here" | base64
  SECRET_KEY: <base64-encoded-secret-key>

  # Example: echo -n "sk-your-openai-api-key" | base64
  OPENAI_API_KEY: <base64-encoded-openai-api-key>

---
# Alternative: Using stringData (Kubernetes will encode automatically)
# Uncomment below and comment out the 'data' section above

# apiVersion: v1
# kind: Secret
# metadata:
#   name: todo-backend-secrets
#   labels:
#     app: todo-backend
# type: Opaque
# stringData:
#   DATABASE_URL: "postgresql+asyncpg://user:pass@host:5432/dbname?ssl=require"
#   SECRET_KEY: "your-jwt-secret-key-here"
#   OPENAI_API_KEY: "sk-your-openai-api-key-here"
