# T025: Staging secrets template - NEVER COMMIT ACTUAL VALUES
#
# Usage:
#   1. Copy this file to secrets.yaml (which is gitignored)
#   2. Replace placeholder values with actual credentials
#   3. Apply: kubectl apply -f secrets.yaml -n todo-staging
#
# Or create secrets directly:
#   kubectl create secret generic db-credentials \
#     --from-literal=DATABASE_URL="postgresql://user:pass@host:5432/db" \
#     -n todo-staging
#
#   kubectl create secret generic kafka-credentials \
#     --from-literal=brokers="pkc-xxxxx.region.confluent.cloud:9092" \
#     --from-literal=username="YOUR_API_KEY" \
#     --from-literal=password="YOUR_API_SECRET" \
#     -n todo-staging
#
#   kubectl create secret generic app-secrets \
#     --from-literal=JWT_SECRET="your-jwt-secret" \
#     --from-literal=OPENAI_API_KEY="sk-xxxxx" \
#     -n todo-staging

---
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  namespace: todo-staging
type: Opaque
stringData:
  DATABASE_URL: "<STAGING_DATABASE_URL>"

---
apiVersion: v1
kind: Secret
metadata:
  name: kafka-credentials
  namespace: todo-staging
type: Opaque
stringData:
  brokers: "<CONFLUENT_CLOUD_BOOTSTRAP_SERVERS>"
  username: "<CONFLUENT_CLOUD_API_KEY>"
  password: "<CONFLUENT_CLOUD_API_SECRET>"

---
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: todo-staging
type: Opaque
stringData:
  JWT_SECRET: "<STAGING_JWT_SECRET>"
  OPENAI_API_KEY: "<OPENAI_API_KEY>"
